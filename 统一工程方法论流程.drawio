<mxfile host="app.diagrams.net" pages="5">
  <diagram name="1 主流程：需求到完成" id="0">
    <mxGraphModel dx="2173" dy="1463" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="开始&#xa;收到变更请求 / 新需求 / 缺陷" vertex="1">
          <mxGeometry height="60" width="370" x="480" y="160" as="geometry" />
        </mxCell>
        <mxCell id="A2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="① 理解现状（第 1、6、7 节）&#xa;⚠ 不得假设「现有实现 = 预期业务行为」&#xa;既有代码可能同时包含：有意行为、历史约束、兼容要求、技术债、意外行为、过时行为&#xa;有意或必需的行为要保留；不要仅因意外行为已存在就保留它&#xa;建立上下文：解决什么问题 · 为何重要 · 影响谁 · 当前行为 · 期望行为 · 约束 · 依赖 · 明确的非范围&#xa;改变既有行为前，先识别受影响的依赖、契约、数据、测试与消费方" vertex="1">
          <mxGeometry height="170" width="370" x="480" y="270" as="geometry" />
        </mxCell>
        <mxCell id="A3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="是缺陷（Bug）吗？&#xa;（第 16 节）" vertex="1">
          <mxGeometry height="100" width="370" x="480" y="490" as="geometry" />
        </mxCell>
        <mxCell id="A4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="② 复杂度与风险分级（第 15 节）&#xa;Trivial · Small · Medium · Large / 架构级&#xa;从最低适用等级开始；命中更高等级条件即上调；不确定时采用更高等级&#xa;⚠ 不把大型工作流强加到极小工作；风险需要深入调研时也不用轻量工作流" vertex="1">
          <mxGeometry height="130" width="370" x="480" y="640" as="geometry" />
        </mxCell>
        <mxCell id="A5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="需要走需求澄清门禁吗？&#xa;新需求 / 需求变更（第 7 节）" vertex="1">
          <mxGeometry height="100" width="370" x="480" y="820" as="geometry" />
        </mxCell>
        <mxCell id="A6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="③ grill-with-docs 需求澄清门禁（第 7 节）&#xa;新需求 / 需求变更的默认门禁，先行执行&#xa;产出先写入持久项目知识与 Trellis，再进入 Trellis 任务流&#xa;⚠ 不得把它当作第二套规格体系" vertex="1">
          <mxGeometry height="120" width="370" x="480" y="970" as="geometry" />
        </mxCell>
        <mxCell id="A7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="④ 调研、证据与结论回写 Trellis（第 5、8 节）&#xa;证据优先于直觉。陈述分级：FACT 事实 · INFERENCE 推断 · ASSUMPTION 假设 · UNKNOWN 未知&#xa;证据来源：源码 · 测试 · 配置 · 数据库结构 · API 契约 · 事件消息 · 文档 · Git 历史 · 部署配置 · 可观测数据&#xa;回写：影响范围/验收标准/优先级/计划/任务/依赖/风险/验证策略/完成条件的结论；阻塞性未决问题；选定方案与理由；证据链接&#xa;可复用知识 → 持久文档；重大决策 → ADR。原始结果与一次性笔记仅作链接材料，不得复制为权威文档&#xa;领域概念复杂或歧义时先用 domain-modeling 建立共享词汇（实体、值对象、聚合、状态迁移、不变量、业务规则、术语、边界）&#xa;⚠ 无证据支撑的陈述只能记为推断或假设，不得记为事实" vertex="1">
          <mxGeometry height="200" width="370" x="480" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="A8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="⑤ 规格与规划（第 9 节 · Trellis 拥有这两个阶段）&#xa;· 业务目标 · 受影响用户或系统 · 范围 · 明确非目标&#xa;· 正常场景下可观测、可测试的验收行为&#xa;· 错误 / 边界 / 权限 / 并发 / 重复请求 / 超时 / 依赖失败 行为&#xa;· 受影响数据 · 状态迁移 · 不变量 · 保留与删除规则&#xa;· API / 事件 / UI / 批处理等外部契约（含错误与版本）&#xa;· 非功能需求：性能 · 容量 · 可用性 · 可观测性 · 安全 · 隐私 · 可达性&#xa;· 兼容影响 · 受影响消费方 · 迁移 / 灰度 / 开关 / 回滚策略&#xa;· 验收 → 验证 映射：每条验收标准至少一种验证方法与预期证据&#xa;· 未决决策：负责人 · 目标解决时间 · 阻塞状态&#xa;⚠ 无法验证的表述（如「体验更好」「快」）不能作为完成标准&#xa;⚠ Trellis 已有相应能力时不自动调用 to-spec / to-tickets；不维护两套竞争性规格" vertex="1">
          <mxGeometry height="260" width="370" x="480" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="A9" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=26;spacingRight=14;verticalAlign=middle;" value="⑥ 人工审批门禁（第 4 节）&#xa;需求目标 / 范围 / 优先级 / 验收标准 → 产品或业务负责人&#xa;重大架构 / API / 数据 / 安全决策 → 技术或架构负责人（ADR）&#xa;未决业务规则 / 例外 / 取舍 → 指定业务或领域负责人&#xa;⚠ 工具与 Agent 可调研、起草、实现、验证、汇总证据，但不拥有业务、风险、架构或生产决策的最终权限&#xa;⚠ 高风险变更不得仅由实现者自批；授权代批须在 Trellis 记录代批人、范围与确认时间&#xa;⚠ 无明确人工确认时，变更即为未批准、未接受、未就绪发布" vertex="1">
          <mxGeometry height="200" width="370" x="480" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="B0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="结束&#xa;状态 ⑥ 完成 · 可追溯链闭合" vertex="1">
          <mxGeometry height="70" width="380" x="1360" y="320" as="geometry" />
        </mxCell>
        <mxCell id="B1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="⑪ 完成判定（第 18 节）— 以下 8 项须全部满足&#xa;1  预期行为已实现&#xa;2  实现满足 Trellis 规格&#xa;3  适当的验证已通过&#xa;4  相关项目规则已满足&#xa;5  重要架构决策已记录&#xa;6  相关持久知识已更新&#xa;7  无未决问题阻塞验收、发布、安全、合规或数据完整性；每个剩余非阻塞问题都有负责人、到期日与关联 Trellis 项&#xa;8  Trellis 任务 / 工作流准确反映最终状态" vertex="1">
          <mxGeometry height="210" width="380" x="1360" y="440" as="geometry" />
        </mxCell>
        <mxCell id="B2" parent="1" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=26;spacingRight=14;verticalAlign=middle;" value="⑩ 人工验收与发布门禁（第 4 节）&#xa;最终完成与验收 → Trellis 任务负责人；需业务验收时 → 业务负责人&#xa;生产发布 / 灰度 / 回滚 / 上线 → 发布或服务负责人（审批 + 运营检查 + 回滚条件）&#xa;风险接受 / 验证例外 / 残余风险 → 变更负责人；高风险变更另设风险负责人&#xa;须业务验收的情形：用户可见业务行为、业务规则、受监管结果、定价、承诺或面向客户的流程发生变更&#xa;每项已批准例外须记录：范围 · 理由 · 残余风险 · 批准人 · 到期或复评日期 · 补偿证据 · 后续 Trellis 项" vertex="1">
          <mxGeometry height="210" width="380" x="1360" y="700" as="geometry" />
        </mxCell>
        <mxCell id="B3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="评审发现已解决&#xa;或被明确接受？" vertex="1">
          <mxGeometry height="90" width="380" x="1360" y="960" as="geometry" />
        </mxCell>
        <mxCell id="B4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="⑨ 代码评审（第 12 节）&#xa;Small / Medium / Large 变更完成前必须评审；Trivial 可不经独立评审（例外走第 4 节）&#xa;评审基准：① 预期需求 ② Trellis 规格 ③ 实现计划 ④ 既有架构约束 ⑤ 测试与验证 ⑥ 向后兼容 ⑦ 可维护性与运营风险&#xa;⚠ 代码能编译、测试能通过 ≠ 变更正确；还须满足预期行为与项目约束" vertex="1">
          <mxGeometry height="160" width="380" x="1360" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="B5" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="Trellis 状态出口检查（第 2 节）&#xa;③ 实现：计划内工作已完成，或任何实质性偏差已按第 17 节处置&#xa;④ 验证：适用的验证已通过，或已批准的例外与残余风险已记录" vertex="1">
          <mxGeometry height="110" width="380" x="1360" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="B6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="验证通过？" vertex="1">
          <mxGeometry height="80" width="380" x="1360" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="B7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="⑧ 测试与验证（第 11 节）&#xa;按变更引入或影响的风险选择验证；多项风险叠加时合并全部适用的最小验证要求&#xa;⚠ 未做适当验证，绝不得声称完成&#xa;中 / 大型工作：风险→验证映射在规格阶段定义，实现阶段补齐执行证据；不得把验证选择推迟到收尾&#xa;自动化不可用时：手工验证须记录可重复步骤、测试数据、预期结果、实际结果与执行人&#xa;验证结果必须反映到 Trellis 工作流中；可用 tdd 等能力实质改进实现过程" vertex="1">
          <mxGeometry height="180" width="380" x="1360" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="B8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="出现重大方向变更？&#xa;（第 17 节）" vertex="1">
          <mxGeometry height="100" width="380" x="1360" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="B9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="⑦ 实现（第 10 节）&#xa;改码前：识别受影响组件 · 理解现有模式 · 识别依赖与契约 · 识别相关测试 · 考虑向后兼容 · 识别迁移与灰度事项&#xa;取满足规格的最小安全变更&#xa;⚠ 不引入无关重构，仅因周边代码本可改进" vertex="1">
          <mxGeometry height="140" width="380" x="1360" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="LB_BUG" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="缺陷调研路径（第 16 节）&#xa;diagnosing-bugs → 证据 → 复现 → 根因 → Trellis 变更定义&#xa;⚠ 根因未达足够可信前，不得实现凭猜测的修复&#xa;详见第 4 页「缺陷处理双路径」" vertex="1">
          <mxGeometry height="130" width="340" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="LB_LIGHT" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;verticalAlign=top;dashed=1;" value="轻量例外（第 7 节）— 须同时满足全部条件：&#xa;· 需求与验收结果完整且无歧义&#xa;· 变更限于单一组件 / 模块 / 服务&#xa;· 不影响公共 API、数据模型、表结构、事件、鉴权、安全、隐私、合规或兼容性&#xa;· 无需调研历史决策、外部文档或跨团队依赖&#xa;· 既有本地测试模式与聚焦验证足以证明正确性&#xa;→ 实现前先在 Trellis 记录：需求、验收标准、例外决定、验证计划&#xa;任一条件不满足或无法确认 → 走 grill-with-docs&#xa;&#xa;仅修正拼写、格式、注释等非行为细节的变更不属于新需求；已批准规格内明确的实现缺口或回归不构成新需求，但仍须走适用的缺陷修复或实现工作流。" vertex="1">
          <mxGeometry height="250" width="340" x="40" y="930" as="geometry" />
        </mxCell>
        <mxCell id="MB_TRACE" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;verticalAlign=top;dashed=1;" value="可追溯链（第 14 节）&#xa;需求 → 上下文/证据 → Trellis 规格 → Trellis 计划/任务 → 实现 → 测试 → 验证 → 评审&#xa;&#xa;工件的确切结构可因项目而异，但意图与实现之间的关系必须保持清晰。每个重要实现决策都应可回溯到明确的需求、约束或架构决策。&#xa;&#xa;第 13 节：实质影响系统边界、服务边界、API、数据模型、事件、持久化、安全、可扩展性、可靠性、部署或向后兼容的决策，须记录到 ADR 等持久工件；不要把重要架构决策埋在对话历史里。" vertex="1">
          <mxGeometry height="250" width="420" x="1800" y="160" as="geometry" />
        </mxCell>
        <mxCell id="MB_GEN" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;verticalAlign=top;dashed=1;" value="通用决策规则（第 19 节）&#xa;每一步都问：达成足够的正确性、清晰度、可追溯性与信心，所需的最小流程量是多少？&#xa;&#xa;优先：证据 &gt; 假设 ｜ 理解 &gt; 猜测 ｜ 单一事实源 &gt; 重复工件&#xa;小的安全变更 &gt; 不必要的重写 ｜ 显式决策 &gt; 隐式假设&#xa;适当验证 &gt; 乐观声明 ｜ 持久知识 &gt; 仅存于对话的记忆&#xa;&#xa;目标不是流程合规，而是可靠的工程。" vertex="1">
          <mxGeometry height="190" width="420" x="1800" y="450" as="geometry" />
        </mxCell>
        <mxCell id="MB_VERIFY" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;verticalAlign=top;dashed=1;" value="风险 → 最小验证 基线（第 11 节）&#xa;· 本地可逆、无外部影响 → 聚焦行为检查（相关测试或人工验证）&#xa;· 核心业务规则 / 复杂分支 → 覆盖正常、边界、失败行为的单元测试&#xa;· API / 事件 / 公共 SDK 等外部契约 → 契约与兼容验证 + 相关集成测试&#xa;· 表结构 / 数据迁移 / 保留 / 删除 → 迁移演练 + 数据完整性检查 + 回滚验证&#xa;· 鉴权 / 认证 / 安全 / 隐私 / 合规 → 正反向授权测试 + 安全评审 + 敏感数据与审计验证&#xa;· 跨服务 / 三方 / 异步 / 消息依赖 → 超时、重试、幂等、失败恢复的集成测试&#xa;· 性能 / 容量 / 高成本执行路径 → 基准或压测对比明确阈值或预算&#xa;· 关键用户旅程 / 复杂交互 → 端到端测试或书面人工验收&#xa;· UI / 可达性 / 国际化 → 键盘、焦点、可访问名、长文本、RTL 检查&#xa;· 部署 / 配置 / 基础设施 / 可用性 → 发布健康验证 + 监控告警 + 回滚验证&#xa;&#xa;Trellis 中须留存对应证据；未执行某项适用基线检查时，按第 4 节记录已批准例外与替代证据。" vertex="1">
          <mxGeometry height="340" width="420" x="1800" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="MB_MAT" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;spacingRight=8;verticalAlign=middle;" value="重大变更处置（第 17 节）&#xa;1. 停止&#xa;2. 说明发生了什么变化&#xa;3. 更新相关 Trellis 工件&#xa;4. 更新 ADR / 契约 / 其他持久记录&#xa;5. 重评受影响的决策、计划、任务与验证&#xa;6. 仅在新方向明确后才继续&#xa;&#xa;重大变更判据：业务目标 / 范围 / 非目标 / 验收标准 · API / 事件 / 数据模型 / 鉴权 / 安全 / 隐私 / 合规行为 · 兼容性 / 受影响消费方 / 迁移 / 灰度 / 回滚策略 · 依赖 / 归属 / 任务计划 / 交付承诺 / 发布时点 · 已批准的架构或领域方案 · 非功能需求或已接受的运营/可靠性/性能风险&#xa;&#xa;实现中出现的局部技术细节，若不改变已批准的范围、验收标准、外部契约、风险等级或交付承诺，可直接决定并记入实现记录，无需中断工作。&#xa;&#xa;⚠ 不确定是否重大时，先按重大处理，直到影响被评估&#xa;⚠ 不得静默继续执行已过期的计划" vertex="1">
          <mxGeometry height="300" width="420" x="1800" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" value="统一工程方法论 · 主流程（Engineering Operating Principles）" vertex="1">
          <mxGeometry height="30" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t1n" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;verticalAlign=top;dashed=1;" value="阅读方向：左列自上而下 → 底部转入右列自下而上。正文括号内为原文对应章节。&#xa;核心原则（第 1 节）：改动前先理解；采用最轻但足以保证正确性、清晰度、可追溯性与可验证性的流程。既不对琐碎变更过度设计，也不对有意义、复杂、含糊或高风险的变更走捷径。&#xa;目标不是机械地遵循流程，而是产出正确、可理解、可验证、可追溯、可维护的软件。" vertex="1">
          <mxGeometry height="80" width="1700" x="40" y="60" as="geometry" />
        </mxCell>
